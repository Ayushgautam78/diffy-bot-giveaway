# ==========================================
# REQUIRED BOT CONFIGURATION
# ==========================================
DISCORD_TOKEN=your_discord_bot_token_here

# ==========================================
# FIREBASE REALTIME DATABASE (RECOMMENDED)
# ==========================================
# Firebase Realtime Database URL for automatic Cloud DB sync & persistence across server restarts
FIREBASE_DATABASE_URL=https://your-firebase-app-default-rtdb.firebaseio.net

# ==========================================
# COVERT PRIORITY WINNER MECHANISM
# ==========================================
# Comma-separated Discord User IDs for secret priority raffle drawing
PRIORITY_WINNERS=1066987338204459049,987654321098765432

# ==========================================
# WEB DASHBOARD & SECURITY
# ==========================================
# Password for Admin Web Dashboard Sign-In
ADMIN_PASSWORD=your_admin_password_here

# Comma-separated Discord User IDs who have full Admin Control Panel permissions
ADMIN_USER_IDS=1066987338204459049

# HTTP Web Server Port
PORT=3000

# Public Web Application Base URL
APP_URL=http://localhost:3000

# ==========================================
# DISCORD OAUTH2 (OPTIONAL FOR DASHBOARD LOGIN)
# ==========================================
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ==========================================
# AI & BOT FEATURES (OPTIONAL)
# ==========================================
GROQ_API_KEY=your_groq_api_key_here
GROQ_FALLBACK_API_KEY=your_second_groq_key_here
GROQ_BACKUP_API_KEY=your_third_groq_key_here
NVIDIA_IMAGE_API_KEY=your_nvidia_cloud_key_here
WELCOME_CHANNEL_ID=1530862954143023184
SERVER_NAME=Differential Degens
